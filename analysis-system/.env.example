# Copy to .env on the server. Never commit real secrets.

APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
PROCESS_ROLE=api-server
LOG_LEVEL=INFO

# Local dev data source:
# - auto: use BOSS_ANALYSIS_DEV_DATA_FILE when present, then summary when configured, otherwise demo data.
# - file: require BOSS_ANALYSIS_DEV_DATA_FILE or --data-file.
# - summary: read only scheduled SQL minute summaries; do not query raw logs.
# - demo / empty: explicit demo or empty state.
BOSS_ANALYSIS_DATA_SOURCE=summary
BOSS_ANALYSIS_REQUIRE_REAL_DATA=1
BOSS_ANALYSIS_NO_DEMO=1
BOSS_ANALYSIS_DEV_DATA_FILE=
BOSS_ANALYSIS_SUMMARY_DATA_FILE=
BOSS_ANALYSIS_LOG_QUALITY_DATA_FILE=
BOSS_ANALYSIS_OPERATOR_CONFIG_FILE=config/operators.local.json
BOSS_ANALYSIS_DAILY_ANALYSIS_RESULT_FILE=
BOSS_ANALYSIS_DAILY_ANALYSIS_RESULTS_DIR=data/daily-analysis-results

# Local operator management page. Put real values in .env or .env.local only.
BOSS_ANALYSIS_OPERATOR_ADMIN_PASSWORD=
BOSS_ANALYSIS_OPERATOR_CONFIG_SECRET=

# One-shot BOSS official result sync. Put real values in .env/.env.local or
# external secret injection only; never commit real cookies or app secrets.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_WIKI_NODE_TOKEN=
FEISHU_DAILY_OPERATOR_RESULT_TABLE_ID=tbl7FU8548wp187I
FEISHU_DAILY_OPERATOR_JOB_RESULT_TABLE_ID=tbl7IizPNJdfxLup
BOSS_OFFICIAL_RESULTS_COOKIE=
BOSS_OFFICIAL_RESULTS_CDP_URL=http://127.0.0.1:9222
BOSS_OFFICIAL_RESULTS_BASE_URL=https://www.zhipin.com
BOSS_OFFICIAL_RESULTS_PAGE_SIZE=100
BOSS_OFFICIAL_RESULTS_MAX_PAGES=100

CLS_KAFKA_BROKERS=
CLS_KAFKA_TOPIC=
CLS_KAFKA_USERNAME=
CLS_KAFKA_PASSWORD=
CLS_KAFKA_GROUP_ID=boss-analysis-system

# Tencent Cloud credentials for development verification. Do not commit real values.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_TOKEN=

# Tencent Cloud CLS scheduled SQL minute summary output.
# Use boss_summary_minute_prod after creating boss_minute_operator_funnel and boss_minute_chat.
CLS_SUMMARY_ENDPOINT=
CLS_SUMMARY_REGION=
CLS_SUMMARY_TOPIC_ID=
CLS_SUMMARY_QUERY=*
CLS_SUMMARY_WINDOW_MINUTES=today
CLS_SUMMARY_LIMIT=1000
CLS_SUMMARY_MAX_PAGES=5
CLS_SUMMARY_SORT=desc

# Tencent Cloud CLS scheduled SQL daily metric output.
# Use boss_summary_daily_prod after creating boss_daily_operator_active_duration.
BOSS_ANALYSIS_DAILY_SUMMARY_DATA_FILE=
CLS_DAILY_SUMMARY_ENDPOINT=
CLS_DAILY_SUMMARY_REGION=
CLS_DAILY_SUMMARY_TOPIC_ID=
CLS_DAILY_SUMMARY_QUERY=*
CLS_DAILY_SUMMARY_WINDOW_MINUTES=today
CLS_DAILY_SUMMARY_LIMIT=1000
CLS_DAILY_SUMMARY_MAX_PAGES=5
CLS_DAILY_SUMMARY_SORT=desc

# Tencent Cloud CLS scheduled SQL daily operator basic-stat metric output.
# Keep metric mode when boss_daily_operator_basic_stats is written to a CLS metric topic.
CLS_DAILY_BASIC_SUMMARY_ENDPOINT=
CLS_DAILY_BASIC_SUMMARY_REGION=
CLS_DAILY_BASIC_SUMMARY_TOPIC_ID=
CLS_DAILY_BASIC_SUMMARY_SOURCE=metric
CLS_DAILY_BASIC_SUMMARY_QUERY=*
CLS_DAILY_BASIC_SUMMARY_WINDOW_MINUTES=today
CLS_DAILY_BASIC_SUMMARY_LIMIT=1000
CLS_DAILY_BASIC_SUMMARY_MAX_PAGES=5
CLS_DAILY_BASIC_SUMMARY_SORT=desc

# Tencent Cloud CLS 10-minute log-quality output.
# Use boss_health_10min_prod after creating boss_10min_log_quality.
CLS_LOG_QUALITY_ENDPOINT=
CLS_LOG_QUALITY_REGION=
CLS_LOG_QUALITY_TOPIC_ID=
CLS_LOG_QUALITY_QUERY=*
CLS_LOG_QUALITY_WINDOW_MINUTES=today
CLS_LOG_QUALITY_LIMIT=1000
CLS_LOG_QUALITY_MAX_PAGES=5
CLS_LOG_QUALITY_SORT=desc

DATABASE_URL=
JWT_SECRET=
COS_BUCKET=
COS_REGION=
SENSITIVE_DATA_ACCESS_ENABLED=false
